          "schema":{
            "$ref":"#/components/schemas/FavoriteIngredient"
          }
        }
      }
    },
    "responses":{"201":{"description":"Added"}}
  }
},

"/preferences/avoided-ingredients":{
  "get":{
    "tags":["Preferences"],
    "parameters":[
      {
        "$ref":"#/components/parameters/UserIdQuery"
      }
    ],
    "responses":{"200":{"description":"OK"}}
  },

  "post":{
    "tags":["Preferences"],
    "requestBody":{
      "content":{
        "application/json":{
          "schema":{
            "$ref":"#/components/schemas/AvoidedIngredient"
          }
        }
      }
    },
    "responses":{"201":{"description":"Added"}}
  }
},

"/preferences/restrictions":{
  "get":{
    "tags":["Preferences"],
    "parameters":[
      {
        "$ref":"#/components/parameters/UserIdQuery"
      }
    ],
    "responses":{"200":{"description":"OK"}}
  },

  "post":{
    "tags":["Preferences"],
    "requestBody":{
      "content":{
        "application/json":{
          "schema":{
            "$ref":"#/components/schemas/UserRestriction"
          }
        }
      }
